# ─────────────────────────────────────────────────────────────
# yt-oto-video Ortam Değişkeni Şablonu (.env.example)
# Bu dosyayı kopyalayarak '.env' olarak kaydedin ve değerleri girin.
# ─────────────────────────────────────────────────────────────

# Pixabay API Anahtarı (https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your_pixabay_api_key_here

# Uzak Sunucu (Remote Worker) SSH Yapılandırması
REMOTE_WORKER_HOST=your_remote_server_ip
REMOTE_WORKER_USER=ubuntu
REMOTE_WORKER_KEY_PATH=/path/to/your/ssh_private_key.key
SSH_STRICT_HOST_KEY_CHECKING=accept-new
