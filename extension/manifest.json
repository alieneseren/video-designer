{
  "manifest_version": 3,
  "name": "YT Otomasyon — Studio Uploader",
  "version": "1.2.0",
  "description": "YouTube Studio yükleme otomasyonu ve Instagram web oturumuyla zamanlanmış video yükleme.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://studio.youtube.com/*",
    "https://www.youtube.com/*",
    "https://www.instagram.com/*",
    "http://localhost/*",
    "http://localhost:*/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:*/*",
    "https://gemini.google.com/*",
    "https://perchance.org/*",
    "https://*.perchance.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://studio.youtube.com/*",
        "https://www.youtube.com/*",
        "https://www.instagram.com/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*",
        "https://gemini.google.com/*",
        "https://perchance.org/*",
        "https://*.perchance.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
