def render_procedural_finance(frame: Image.Image, draw: ImageDraw.ImageDraw, stype: str, t_sub: float, scene_data: dict):
    for gx in range(0, W, 60): draw.line([(gx, 0), (gx, H)], fill=(20, 32, 50), width=1)
    for gy in range(0, H, 60): draw.line([(0, gy), (W, gy)], fill=(20, 32, 50), width=1)

    bx, by, bw, bh = 680, 180, 1140, 720
    draw.rectangle([(bx, by), (bx + bw, by + bh)], fill=(18, 28, 48, 240), outline=(34, 197, 94), width=4)
    draw.rectangle([(bx, by), (bx + bw, by + 75)], fill=(34, 197, 94))
    draw.text((bx + 30, by + 16), "PENTAGON TEDARİK MALİYET KARŞILAŞTIRMASI", font=get_pop_font(32), fill=(15, 23, 42))

    if "SPONGE" in stype:
        p1_val, p1_str = 820, "$1.20 (BİR DOLAR YİRMİ SENT)"
        p2_val, p2_str = bx + bw - 60, "$4.800 (DÖRT BİN SEKİZ YÜZ DOLAR)"
        markup = "+%399.900 FİYAT ARTIŞI"
        item_lbl = "Sivil Sünger vs Askeri Elmas Tozlu Taktik Sünger"
    elif "STENCIL" in stype:
        p1_val, p1_str = 860, "$8.50 (PLASTİK ŞABLON)"
        p2_val, p2_str = bx + bw - 60, "$12.000 (TİTANYUM ŞABLON)"
        markup = "+%141.000 FİYAT ARTIŞI"
        item_lbl = "Plastik Şablon vs Lazer Kesim Titanyum Şablon"
    elif "CANOPY" in stype:
        p1_val, p1_str = 900, "$1.200 (STANDART TEMİZLEME)"
        p2_val, p2_str = bx + bw - 60, "$280.000 (KANOPİ YENİLEME)"
        markup = "+%23.200 FİYAT ARTIŞI"
        item_lbl = "Solvent Hasarı Nedeniyle Değişen Jet Kanopisi"
    elif "SENATE" in stype:
        p1_val, p1_str = 840, "$0 (BÜTÇE İZİN SINIRI)"
        p2_val, p2_str = bx + bw - 60, "$80.000.000 (HARCANAN PARAFİN BÜTÇESİ)"
        markup = "SENATO SORUŞTURMASI"
        item_lbl = "Senato Silahlı Kuvvetler Komitesi Denetimi"
    else:
        p1_val, p1_str = 820, "$0.15 (15 SENT)"
        p2_val, p2_str = bx + bw - 60, "$68.400.000.000 (TOPLAM PROGRAM)"
        markup = "+%3.200.000 MALİYET PATLAMASI"
        item_lbl = "Normal Mum Boya vs Mark 4 Taktik Yazım Sistemi"

    draw.text((bx + 40, by + 120), "SİVİL PİYASA MALİYETİ:", font=get_pop_font(26), fill=(148, 163, 184))
    draw.rectangle([(bx + 40, by + 165), (min(p1_val, bx + 250), by + 235)], fill=(34, 197, 94))
    draw.text((bx + 270, by + 175), p1_str, font=get_pop_font(34), fill=(34, 197, 94))

    draw.text((bx + 40, by + 280), "PENTAGON SAVUNMA SÖZLEŞMESİ:", font=get_pop_font(26), fill=(239, 68, 68))
    draw.rectangle([(bx + 40, by + 325), (p2_val, by + 395)], fill=(239, 68, 68))
    draw.text((bx + 60, by + 335), p2_str, font=get_pop_font(34), fill=(255, 255, 255))

    draw.rectangle([(bx + 40, by + 460), (bx + bw - 40, by + bh - 40)], fill=(15, 23, 42), outline=(234, 179, 8), width=3)
    draw.text((bx + 70, by + 490), f"VERGİ MÜKELLEFİ KAYBI: {markup}", font=get_pop_font(36), fill=(234, 179, 8))
    draw.text((bx + 70, by + 560), item_lbl, font=get_pop_font(26), fill=(203, 213, 225))


def render_animated_scene(
    scene_data: dict,
    wav_path: Path,
    output_mp4: Path,
    vehicle_name: str,
    idx: int,
    total_scenes: int = 34
):
    dur = get_audio_duration(str(wav_path))
    total_frames = max(25, int(dur * FPS))

    subshots, titles = select_scene_subshots(scene_data, idx, dur, vehicle_name)
    sub_dur = dur / float(len(subshots))

    # SFX events
    sfx_events = []
    whoosh_f = SFX_DIR / "whoosh.mp3"
    pop_f = SFX_DIR / "pop.mp3"
    cash_f = SFX_DIR / "cash_register.wav"
    stamp_f = SFX_DIR / "stamp.wav"
    sonar_f = SFX_DIR / "sonar_ping.wav"

    if whoosh_f.exists(): sfx_events.append((whoosh_f, 0.05, 0.40))
    if pop_f.exists(): sfx_events.append((pop_f, 0.50, 0.50))

    for s_i, stype in enumerate(subshots):
        st_t = s_i * sub_dur
        if s_i > 0 and whoosh_f.exists(): sfx_events.append((whoosh_f, st_t, 0.35))
        if "FINANCE" in stype and cash_f.exists(): sfx_events.append((cash_f, st_t + 0.5, 0.45))
        elif stype == "PHOTO" and stamp_f.exists(): sfx_events.append((stamp_f, st_t + 0.5, 0.50))
        elif ("MAP" in stype or stype == "COCKPIT") and sonar_f.exists(): sfx_events.append((sonar_f, st_t + 0.7, 0.35))

    mixed_wav = wav_path.parent / f"mixed_{wav_path.name}"
    try:
        mix_scene_audio(wav_path, sfx_events, mixed_wav, speaker_side="CENTER")
    except Exception:
        mixed_wav = wav_path

    # Preload Character Poses
    host_walk = get_host_pose("walking", 620)
    host_point = get_host_pose("pointing", 620)
    host_shock = get_host_pose("shocked", 620)
    host_smug = get_host_pose("smug", 620)
    general_img = load_character_sprite("GENERAL", 600)
    pilot_img = load_character_sprite("PILOT", 680)

    # Real photos pool to rotate
    photos_pool = [
        (B21_FLIGHT_REAL, "USAF FLIGHT TEST ARCHIVE // EDWARDS AFB", "AIRCRAFT: B-21 RAIDER SERIAL AF-21-001", "TOP SECRET"),
        (B21_ROLLOUT_REAL, "PALMDALE PLANT 42 ROLLOUT SPECIFICATION", "AUDIT: RADAR ABSORBENT COATING ADHESION", "DECLASSIFIED"),
        (B21_BLUEPRINT_IMG, "TECHNICAL BLUEPRINT DRAFTING ARCHIVE", "SCHEMATIC: MIL-STD 810H THERMAL SPEC", "SPEC FAILED"),
        (B21_CUTOUT_REAL, "USAF WEAPONS INTEGRATION MATRIX", "PAYLOAD: STANDOFF CRUISE MISSILE INTERFACE", "CRITICAL FLAW"),
    ]

    cmd = [
        FFMPEG_BIN, "-y",
        "-f", "rawvideo", "-vcodec", "rawvideo",
        "-s", f"{W}x{H}", "-pix_fmt", "rgba", "-r", str(FPS),
        "-i", "-",
        "-i", str(mixed_wav),
        "-c:v", "libx264", "-preset", "ultrafast", "-crf", "20", "-pix_fmt", "yuv420p",
        "-c:a", "aac", "-b:a", "192k",
        "-shortest",
        str(output_mp4)
    ]
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stderr=subprocess.DEVNULL)

    chapter = scene_data.get("chapter", "").strip().upper()
    narration_text = scene_data.get("narration", "").strip()

    for f_idx in range(total_frames):
        t = f_idx / float(FPS)
        s_i = min(len(subshots) - 1, int(t / sub_dur))
        t_sub = t - (s_i * sub_dur)
        sub_type = subshots[s_i]
        sub_title = titles[s_i]

        # ── 1. MAP SUB-SHOTS ──
        if "MAP" in sub_type:
            frame = get_cached_bg(MAP_BG).copy()
            draw = ImageDraw.Draw(frame)
            if "ARCTIC" in sub_type:
                p1, p2 = (300, 320), (1450, 240)
                mid_x, mid_y = 860, 160
            elif "CARRIER" in sub_type:
                p1, p2 = (280, 720), (1550, 620)
                mid_x, mid_y = 920, 520
            else:
                p1, p2 = (340, 580), (1500, 460)
                mid_x, mid_y = 920, 260

            p = min(1.0, t_sub / 2.2)
            num_segs = int(28 * p)
            for seg_i in range(num_segs):
                bt0, bt1 = seg_i / 28.0, (seg_i + 0.6) / 28.0
                def bez(bt):
                    bx = (1 - bt)**2 * p1[0] + 2 * (1 - bt) * bt * mid_x + bt**2 * p2[0]
                    by = (1 - bt)**2 * p1[1] + 2 * (1 - bt) * bt * mid_y + bt**2 * p2[1]
                    return (int(bx), int(by))
                draw.line([bez(bt0), bez(bt1)], fill=(220, 38, 38, 255), width=7)

            if t_sub >= 1.6:
                pin_x, pin_y = p2
                draw.ellipse([(pin_x - 18, pin_y - 45), (pin_x + 18, pin_y - 9)], fill=(220, 38, 38), outline=(255, 255, 255), width=3)
                draw.polygon([(pin_x - 14, pin_y - 20), (pin_x + 14, pin_y - 20), (pin_x, pin_y + 6)], fill=(220, 38, 38))
                draw.ellipse([(pin_x - 7, pin_y - 32), (pin_x + 7, pin_y - 18)], fill=(255, 255, 255))
            frame.alpha_composite(host_point, (60, H - host_point.height - 20))
            draw_pop_title(draw, sub_title)

        # ── 2. TECHNICAL SCHEMATIC SUB-SHOTS ──
        elif "SCHEMATIC" in sub_type:
            frame = Image.new("RGBA", (W, H), (15, 23, 42, 255))
            draw = ImageDraw.Draw(frame)
            render_procedural_schematic(frame, draw, sub_type, t_sub, scene_data)
            char_to_use = host_shock if ("HEAT" in sub_type or "HUMVEE" in sub_type or "OPTICAL" in sub_type or "CANOPY" in sub_type) else host_point
            frame.alpha_composite(char_to_use, (60, H - char_to_use.height - 20))
            draw_pop_title(draw, sub_title)

        # ── 3. FINANCIAL SUB-SHOTS ──
        elif "FINANCE" in sub_type:
            frame = Image.new("RGBA", (W, H), (12, 18, 30, 255))
            draw = ImageDraw.Draw(frame)
            render_procedural_finance(frame, draw, sub_type, t_sub, scene_data)
            frame.alpha_composite(host_shock, (60, H - host_shock.height - 20))
            draw_pop_title(draw, sub_title)

        # ── 4. REAL PHOTO DOSSIER SUB-SHOT ──
        elif sub_type == "PHOTO":
            frame = Image.new("RGBA", (W, H), (15, 23, 42, 255))
            draw = ImageDraw.Draw(frame)
            for gx in range(0, W, 80): draw.line([(gx, 0), (gx, H)], fill=(22, 36, 60), width=1)
            for gy in range(0, H, 80): draw.line([(0, gy), (W, gy)], fill=(22, 36, 60), width=1)
            card_w, card_h = 960, 640
            card_x, card_y = 780, 190
            draw.rectangle([(card_x + 12, card_y + 12), (card_x + card_w + 12, card_y + card_h + 12)], fill=(0, 0, 0, 160))
            draw.rectangle([(card_x, card_y), (card_x + card_w, card_y + card_h)], fill=(245, 245, 240), outline=(200, 200, 190), width=3)
            
            p_img_path, p_cap, p_sub, p_stamp = photos_pool[(idx + s_i) % len(photos_pool)]
            if p_img_path.exists():
                rf_img = get_cached_bg(p_img_path, (card_w - 40, card_h - 100))
                frame.alpha_composite(rf_img, (card_x + 20, card_y + 20))
            draw.text((card_x + 30, card_y + card_h - 60), p_cap, font=get_pop_font(24), fill=(30, 41, 59))
            draw.text((card_x + 30, card_y + card_h - 32), p_sub, font=get_font_safe(16, mono=True), fill=(100, 116, 139))
            stamp_img = get_cached_stamp(p_stamp, 12)
            frame.alpha_composite(stamp_img, (card_x + card_w - 360, card_y + 40))
            frame.alpha_composite(host_point, (60, H - host_point.height - 20))
            draw_pop_title(draw, sub_title)

        # ── 5. WALK SUB-SHOT ──
        elif sub_type == "WALK":
            frame = get_cached_bg(HANGAR_BG).copy()
            draw = ImageDraw.Draw(frame)
            p_walk = min(1.0, t_sub / 1.8)
            hx = int(-140 + p_walk * 440)
            bob = int(abs(math.sin(t_sub * 10.0)) * 12.0 if p_walk < 1.0 else 0)
            hy = H - host_walk.height - 20 - bob
            host_cur = host_walk if p_walk < 1.0 else host_smug
            frame.alpha_composite(host_cur, (hx, hy))
            if p_walk < 1.0:
                draw_footstep_dust(draw, hx + host_cur.width // 2, H - 20, t_sub * 10.0)
            draw_pop_title(draw, sub_title)

        # ── 6. COCKPIT SUB-SHOT ──
        elif sub_type == "COCKPIT":
            frame = get_cached_bg(COCKPIT_BG).copy()
            draw = ImageDraw.Draw(frame)
            draw_doc_cockpit_hud(draw, t_sub)
            px = int(W * 0.58)
            vib_y = int(math.sin(t_sub * 20.0) * 3.0)
            py = H - pilot_img.height + 60 + vib_y
            frame.alpha_composite(pilot_img, (px, py))
            draw_pop_title(draw, sub_title)

        # ── 7. CONFRONTATION SUB-SHOT ──
        elif sub_type == "CONFRONTATION":
            frame = get_cached_bg(WAR_ROOM_BG).copy()
            draw = ImageDraw.Draw(frame)
            rcx, rcy = 960, 320
            for r in [90, 180]: draw.ellipse([(rcx-r, rcy-r), (rcx+r, rcy+r)], outline=(34, 197, 94), width=2)
            ang = (t_sub * 3.0) % (2 * math.pi)
            draw.line([(rcx, rcy), (rcx + int(math.cos(ang)*180), rcy + int(math.sin(ang)*180))], fill=(34, 197, 94), width=3)
            frame.alpha_composite(host_smug, (100, H - host_smug.height - 20))
            frame.alpha_composite(general_img, (W - general_img.width - 100, H - general_img.height - 20))
            draw_pop_title(draw, sub_title)

        # ── 8. TERMINAL SUB-SHOT ──
        else:
            frame = Image.new("RGBA", (W, H), (8, 16, 12, 255))
            draw = ImageDraw.Draw(frame)
            for y in range(0, H, 6): draw.line([(0, y), (W, y)], fill=(12, 28, 18), width=2)
            draw.rectangle([(100, 160), (W - 100, H - 120)], outline=(0, 255, 120), width=3)
            draw.rectangle([(100, 160), (W - 100, 220)], fill=(0, 255, 120))
            draw.text((120, 175), f"PENTAGON SECURE TERMINAL // {chapter[:32]}", font=get_pop_font(28), fill=(8, 16, 12))
            
            # Extract real narration snippet
            words = narration_text.split()
            snippet_1 = " ".join(words[:10]) if len(words) >= 10 else narration_text
            snippet_2 = " ".join(words[10:20]) if len(words) >= 20 else ""
            log_lines = [
                f"> AUDIT CHAPTER: {chapter[:45]}",
                f"> TRANSCRIPT: {snippet_1[:50]}",
                f"> LOG: {snippet_2[:50]}" if snippet_2 else "> STATUS: CRITICAL FAILURE IDENTIFIED",
                f"> VERDICT: MIL-STD 810H PROTOCOL VIOLATION DETECTED",
                f"> CLASSIFICATION: TOP SECRET // DOD OVERSIGHT ONLY"
            ]
            t_chars = int(t_sub * 40)
            curr_chars = 0
            y_pos = 260
            font_term = get_pop_font(28)
            for line in log_lines:
                if t_chars > curr_chars:
                    visible = line[:t_chars - curr_chars]
                    draw.text((140, y_pos), visible, font=font_term, fill=(0, 255, 120))
                curr_chars += len(line)
                y_pos += 60
            if int(t_sub * 3) % 2 == 0:
                draw.rectangle([(140 + min(t_chars * 14, 800), y_pos - 60), (160 + min(t_chars * 14, 800), y_pos - 30)], fill=(0, 255, 120))
            draw_pop_title(draw, sub_title)

        proc.stdin.write(frame.tobytes())

    proc.stdin.close()
    proc.wait()


def format_ass_time(seconds: float) -> str:
    h = int(seconds // 3600)
    m = int((seconds % 3600) // 60)
    s = int(seconds % 60)
    cs = int(round((seconds - int(seconds)) * 100))
    if cs >= 100: cs = 99
    return f"{h}:{m:02d}:{s:02d}.{cs:02d}"


def build_ass_subtitles(scenes_info: list, output_path: Path):
    ass_lines = [
        "[Script Info]", "ScriptType: v4.00+", f"PlayResX: {W}", f"PlayResY: {H}", "",
        "[V4+ Styles]",
        "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding",
        "Style: Default,Helvetica,48,&H00FFFFFF,&H000000FF,&H000F172A,&H90000000,-1,0,0,0,100,100,0,0,1,3.5,2,2,70,70,80,1", "",
        "[Events]", "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text"
    ]
    for item in scenes_info:
        words = item["narration"].strip().split()
        if not words: continue
        chunk_sz = 6
        chunks = [" ".join(words[c:c+chunk_sz]) for c in range(0, len(words), chunk_sz)]
        c_dur = item["duration"] / len(chunks)
        for c_i, ch in enumerate(chunks):
            t1 = format_ass_time(item["start_time"] + (c_i * c_dur))
            t2 = format_ass_time(min(item["start_time"] + item["duration"], item["start_time"] + ((c_i + 1) * c_dur)))
            ass_lines.append(f"Dialogue: 0,{t1},{t2},Default,,0,0,0,,{ch}")
    output_path.write_text("\n".join(ass_lines), encoding="utf-8")


def render_full_animated_crayon_video(mat_dir: Path, dest_dir: Path) -> Path:
    dest_dir.mkdir(parents=True, exist_ok=True)
    work_dir = BASE_DIR / "scratch" / f"animated_{mat_dir.name}"
    work_dir.mkdir(parents=True, exist_ok=True)

    with open(mat_dir / "material.json", encoding="utf-8") as f:
        mat = json.load(f)

    script = mat.get("script") or mat.get("script_data") or {}
    scenes = script.get("scenes") or mat.get("scenes", [])
    vehicle_name = script.get("vehicle_name") or script.get("title") or "B-21 RAIDER STEALTH BOMBER"

    print(f"🎬 [BoşKafa Content Engine] '{script.get('title')}' için içerik duyarlı şematikli ve pop-title prodüksiyon başlıyor ({len(scenes)} sahne)...")
    t0 = time.time()

    scenes_info = []
    cumulative_time = 0.0

    for i, s in enumerate(scenes):
        wav_p = mat_dir / f"scene_{i}_audio.wav"
        if not wav_p.exists():
            wav_p = mat_dir / f"scene_{i}_audio.mp3"
        dur = get_audio_duration(str(wav_p))

        char_val = s.get("active_character") or s.get("character") or s.get("char") or "DEFENSE_CEO"
        diag_val = s.get("character_dialogue") or s.get("dialogue") or s.get("character_quote") or ""

        scenes_info.append({
            "idx": i,
            "chapter": s.get("chapter", ""),
            "char": char_val,
            "active_character": char_val,
            "type": s.get("visual_type", "blueprint_spec"),
            "dialogue": diag_val,
            "character_dialogue": diag_val,
            "narration": s.get("narration", ""),
            "wav_path": wav_p,
            "duration": dur,
            "start_time": cumulative_time
        })
        cumulative_time += dur

    total_duration = cumulative_time
    print(f"⏱️ Toplam Video Süresi: {total_duration:.1f}s ({total_duration/60:.2f} dakika)")

    segment_files = []
    for item in scenes_info:
        idx = item["idx"]
        dur = item["duration"]
        clip_mp4 = work_dir / f"clip_{idx:02d}.mp4"

        t_clip = time.time()
        render_animated_scene(
            scene_data=item,
            wav_path=item["wav_path"],
            output_mp4=clip_mp4,
            vehicle_name=vehicle_name,
            idx=idx,
            total_scenes=len(scenes_info)
        )
        segment_files.append(clip_mp4)
        print(f"  ✨ Sahne {idx+1}/{len(scenes_info)} canlandırıldı ({dur:.1f}s, render: {time.time()-t_clip:.2f}s)")

    # Concatenate all clips
    concat_list = work_dir / "concat_list.txt"
    concat_list.write_text("\n".join([f"file '{p.resolve()}'" for p in segment_files]), encoding="utf-8")
    merged_raw = work_dir / "merged_raw.mp4"

    cmd_concat = [FFMPEG_BIN, "-y", "-f", "concat", "-safe", "0", "-i", str(concat_list), "-c", "copy", str(merged_raw)]
    subprocess.run(cmd_concat, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)

    # Subtitles
    ass_file = work_dir / "subtitles.ass"
    build_ass_subtitles(scenes_info, ass_file)

    final_output = dest_dir / "final.mp4"
    dest_video_mp4 = dest_dir / "video.mp4"

    print(f"🎵 Fon müziği miksleniyor ve altyazılar işleniyor...")
    final_cmd = [
        FFMPEG_BIN, "-y",
        "-i", str(merged_raw),
        "-stream_loop", "-1", "-i", str(BGM_FILE),
        "-filter_complex", (
            f"[0:v]ass={str(ass_file)}[vout];"
            f"[0:a]loudnorm=I=-15:TP=-1.5:LRA=9[vocal];"
            f"[1:a]volume=0.06[bgm];"
            f"[vocal][bgm]amix=inputs=2:duration=first:dropout_transition=2:normalize=0[aout]"
        ),
        "-map", "[vout]", "-map", "[aout]",
        "-c:v", "libx264", "-preset", "veryfast", "-crf", "20",
        "-c:a", "aac", "-b:a", "192k",
        "-shortest",
        str(final_output)
    ]
    subprocess.run(final_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
    shutil.copyfile(str(final_output), str(dest_video_mp4))

    file_size_mb = round(final_output.stat().st_size / (1024 * 1024), 2)
    print(f"🎉 [TAMAMLANDI] Animasyonlu video hazır: {final_output.name} ({file_size_mb} MB, {total_duration/60:.2f} dk, toplam: {time.time()-t0:.1f}s)")

    chapter_lines = []
    c_time = 0.0
    for item in scenes_info:
        ch = item["chapter"] or item["narration"][:40]
        m = int(c_time // 60)
        s = int(c_time % 60)
        chapter_lines.append(f"{m:02d}:{s:02d} - {ch}")
        c_time += item["duration"]

    title = script.get("title") or vehicle_name
    chapters_block = "\n\nTIMESTAMPS / CHAPTERS:\n" + "\n".join(chapter_lines[:15])
    desc_text = f"{title}\n\nSatirical military tech breakdown and defense contractor reality check.\n\n#Military #Defense #B21Raider #TechBreakdown #Documentary #Viral" + chapters_block

    (dest_dir / "video_info.json").write_text(json.dumps({
        "title": title,
        "video_path": str(final_output),
        "file_size_mb": file_size_mb,
        "duration": round(total_duration, 1),
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "channel_id": "tacticallcrayon"
    }, indent=2, ensure_ascii=False), encoding="utf-8")

    (dest_dir / "metadata.json").write_text(json.dumps({
        "title": title,
        "description": desc_text,
        "tags": script.get("tags") or ["Military", "Defense", "B-21 Raider", "Stealth Bomber", "Satire", "Crayon"],
        "channel_id": "tacticallcrayon",
        "file_size_mb": file_size_mb,
        "duration": round(total_duration, 1),
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%S")
    }, indent=2, ensure_ascii=False), encoding="utf-8")

    (dest_dir / "youtube_metadata.txt").write_text(
        f"TITLE:\n{title}\n\nDESCRIPTION:\n{desc_text}\n\nTAGS:\n{', '.join(script.get('tags') or ['Military', 'Defense', 'B-21 Raider', 'Documentary'])}\n",
        encoding="utf-8"
    )

    return final_output


if __name__ == "__main__":
    import argparse
    parser = argparse.ArgumentParser(description="Render animated Crayon Combat video.")
    parser.add_argument("--mat-dir", required=True, help="Material directory path")
    parser.add_argument("--dest-dir", required=True, help="Destination directory path")
    args = parser.parse_args()

    render_full_animated_crayon_video(Path(args.mat_dir), Path(args.dest_dir))
