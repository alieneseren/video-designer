def get_font_safe(size: int, bold: bool = False, mono: bool = False) -> ImageFont.ImageFont:
    candidates = []
    if mono:
        candidates = [
            "/System/Library/Fonts/SFNSMono.ttf",
            "/System/Library/Fonts/Menlo.ttc",
            "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf",
            "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
        ]
    elif bold:
        candidates = [
            "/System/Library/Fonts/Supplemental/Impact.ttf",
            "/System/Library/Fonts/HelveticaNeue.ttc",
            "/System/Library/Fonts/Helvetica.ttc",
            "/System/Library/Fonts/SFProDisplay-Bold.otf",
            "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
            "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf",
        ]
    else:
        candidates = [
            "/System/Library/Fonts/HelveticaNeue.ttc",
            "/System/Library/Fonts/Helvetica.ttc",
            "/System/Library/Fonts/SFProText-Regular.otf",
            "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
            "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
        ]
    for p in candidates:
        if os.path.exists(p):
            try:
                return ImageFont.truetype(p, size)
            except Exception:
                pass
    return ImageFont.load_default()


def get_pop_font(size: int = 56) -> ImageFont.ImageFont:
    candidates = [
        "/System/Library/Fonts/Supplemental/Impact.ttf",
        "/System/Library/Fonts/Helvetica.ttc",
        "/System/Library/Fonts/HelveticaNeue.ttc",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
        "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf",
    ]
    for p in candidates:
        if os.path.exists(p):
            try:
                return ImageFont.truetype(p, size)
            except Exception:
                pass
    return get_font_safe(size, bold=True)


def draw_pop_title(draw: ImageDraw.ImageDraw, text: str, y: int = 55, font_size: int = 56, text_color=(255, 255, 255), outline_color=(15, 23, 42)):
    if not text:
        return
    text = text.upper()
    font = get_pop_font(font_size)
    bbox = font.getbbox(text)
    tw = bbox[2] - bbox[0]
    tx = (W - tw) // 2
    # Drop shadow
    draw.text((tx + 4, y + 4), text, font=font, fill=(0, 0, 0, 160))
    # Native C stroke + text
    draw.text((tx, y), text, font=font, fill=text_color, stroke_width=6, stroke_fill=outline_color)


def get_audio_duration(file_path: str) -> float:
    try:
        with wave.open(file_path, "rb") as w:
            return w.getnframes() / float(w.getframerate())
    except Exception:
        pass
    try:
        cmd = ["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "default=noprint_wrappers=1:nokey=1", file_path]
        out = subprocess.check_output(cmd, text=True).strip()
        return float(out)
    except Exception:
        return 5.0


# ── CACHED GRAPHICS ASSETS ──
_CACHED_IMGS = {}

def get_cached_bg(path: Path, target_size=(W, H)) -> Image.Image:
    k = (str(path), target_size)
    if k not in _CACHED_IMGS:
        if path.exists():
            im = Image.open(path).convert("RGBA")
            if target_size:
                im = im.resize(target_size, Image.Resampling.LANCZOS)
            _CACHED_IMGS[k] = im
        else:
            _CACHED_IMGS[k] = Image.new("RGBA", target_size, (15, 23, 42, 255))
    return _CACHED_IMGS[k]


_CACHED_POSES = {}

def get_host_pose(name: str, target_h: int = 620) -> Image.Image:
    k = (name, target_h)
    if k not in _CACHED_POSES:
        p = CHAR_DIR / f"host_{name}.png"
        if not p.exists():
            p = CHAR_DIR / f"crayon_{name}.png"
        if not p.exists():
            p = CHAR_DIR / f"{name}.png"
        if not p.exists():
            p = CHAR_DIR / "boskafa_tactical_host.png"
        if p.exists():
            raw = Image.open(p).convert("RGBA")
            sc = target_h / float(raw.height)
            nw = int(raw.width * sc)
            _CACHED_POSES[k] = raw.resize((nw, target_h), Image.Resampling.LANCZOS)
        else:
            _CACHED_POSES[k] = Image.new("RGBA", (int(target_h * 0.45), target_h), (0, 0, 0, 0))
    return _CACHED_POSES[k]


def load_character_sprite(char_role: str, target_h: int = 640) -> Image.Image:
    role_u = char_role.upper()
    file_map = {
        "HOST": "host_smug.png",
        "PILOT": "crayon_test_pilot.png",
        "GENERAL": "crayon_pentagon_general.png",
        "CEO": "crayon_defense_ceo.png",
        "SPY": "foreign_spy.png",
        "FOUNDER": "crayon_tech_founder.png",
        "TRADER": "crayon_wall_street_trader.png"
    }
    target_file = "host_smug.png" if any(k in role_u for k in ["HOST", "ANALYST", "NARRATOR"]) else "crayon_defense_ceo.png"
    for k, v in file_map.items():
        if k in role_u:
            target_file = v
            break
    p = CHAR_DIR / target_file
    if not p.exists():
        alt_name = target_file.replace("crayon_", "")
        if (CHAR_DIR / alt_name).exists():
            p = CHAR_DIR / alt_name
    if p.exists():
        raw = Image.open(p).convert("RGBA")
        scale = target_h / float(raw.height)
        new_w = int(raw.width * scale)
        return raw.resize((new_w, target_h), Image.Resampling.LANCZOS)
    return Image.new("RGBA", (int(target_h * 0.45), target_h), (0, 0, 0, 0))


_CACHED_STAMPS = {}

def get_cached_stamp(text: str = "TOP SECRET", angle: int = 14) -> Image.Image:
    k = (text, angle)
    if k not in _CACHED_STAMPS:
        sw, sh = 360, 80
        s_img = Image.new("RGBA", (sw, sh), (0, 0, 0, 0))
        sd = ImageDraw.Draw(s_img)
        sd.rectangle([(0, 0), (sw - 1, sh - 1)], outline=(220, 38, 38), width=5)
        s_font = get_pop_font(32)
        sd.text((20, 18), text, font=s_font, fill=(220, 38, 38))
        _CACHED_STAMPS[k] = s_img.rotate(angle, expand=True, resample=Image.Resampling.BILINEAR)
    return _CACHED_STAMPS[k]


def draw_footstep_dust(draw: ImageDraw.ImageDraw, foot_x: int, ground_y: int, walk_phase: float):
    strike = abs(math.sin(walk_phase))
    if strike < 0.35:
        p = 1.0 - (strike / 0.35)
        puff_r = int(14 * p)
        if puff_r > 3:
            draw.ellipse([(foot_x - puff_r - 8, ground_y - puff_r), (foot_x + puff_r - 8, ground_y + 4)], fill=(220, 225, 235, 180), outline=(100, 116, 139, 200), width=2)
            draw.ellipse([(foot_x - puff_r + 12, ground_y - int(puff_r * 0.7)), (foot_x + puff_r + 12, ground_y + 4)], fill=(240, 245, 250, 160), outline=(100, 116, 139, 180), width=1)


def draw_doc_cockpit_hud(draw: ImageDraw.ImageDraw, t: float):
    hud_y = int(220 + math.sin(t * 3.0) * 15.0)
    draw.line([(880, hud_y), (1040, hud_y)], fill=(0, 255, 120, 200), width=2)
    draw.text((910, hud_y - 20), "ALT: 52,000 FT", font=get_font_safe(18, mono=True), fill=(0, 255, 120))

    is_flash = (int(t * 2.0) % 2 == 0)
    border_col = (239, 68, 68) if is_flash else (234, 179, 8)
    box_fill = (220, 38, 38, 230) if is_flash else (234, 179, 8, 220)
    text_fill = (255, 255, 255) if is_flash else (15, 23, 42)

    draw.rounded_rectangle([(100, 100), (530, 180)], radius=12, fill=box_fill, outline=border_col, width=3)
    draw.text((120, 115), "WARNING // THERMAL MELT HAZARD", font=get_font_safe(20, bold=True), fill=text_fill)
    draw.text((120, 145), "FLIGHT STICK RESIDUE DETECTED", font=get_font_safe(14, mono=True), fill=text_fill)


# ── CONTENT-AWARE SUB-SHOT SELECTOR ──
def select_scene_subshots(scene_data: dict, idx: int, dur: float, vehicle_name: str) -> Tuple[List[str], List[str]]:
    chapter = scene_data.get("chapter", "").strip().upper()
    narr = scene_data.get("narration", "").lower()
    diag = (scene_data.get("character_dialogue") or "").lower()
    text = (chapter + " " + narr + " " + diag)
    
    num_subshots = max(1, int(round(dur / 4.5)))

    # Topic detectors
    is_thermal = any(w in text for w in ["melt", "heat", "temperature", "celsius", "48", "98.6", "thermal", "greenhouse", "solar", "warm"])
    is_arctic = any(w in text for w in ["arctic", "norway", "minus", "-30", "freeze", "cold response", "frost", "snap", "tundra"])
    is_nvg = any(w in text for w in ["infrared", "night vision", "nvg", "spectral", "emissivity", "thermal blooming", "dawn patrol", "flir"])
    is_optical = any(w in text for w in ["red-light", "red light", "invisible", "color-code", "color-coding", "optical illusion", "blackout"])
    is_canopy = any(w in text for w in ["canopy", "solvent", "wipe", "chemical", "coat", "coating", "clean", "micro-crack"])
    is_humvee = any(w in text for w in ["humvee", "defrost", "vent", "heater", "dashboard", "smoke", "2004", "maneuver"])
    is_sponge = any(w in text for w in ["sponge", "4,800", "prep", "laminate", "surface friction"])
    is_stencil = any(w in text for w in ["stencil", "titanium", "12,000", "trench", "mud"])
    is_senate = any(w in text for w in ["senate", "congress", "subcommittee", "hearing", "80 million", "testimony", "investigat"])
    is_carrier = any(w in text for w in ["naval", "carrier", "kneeboard", "plexiglas", "strike aviation"])
    is_symbol_x = any(w in text for w in ["diagonal slash", "quadrant", "crossed x", "search in progress", "hazard ring", "clean path", "chevron"])
    is_triage = any(w in text for w in ["triage", "casualty", "biosensing", "cross", "medical"])
    is_breach = any(w in text for w in ["breaching", "anchor", "demolition", "c4", "bracket", "concrete"])
    is_abrams = any(w in text for w in ["abrams", "tank", "friendly fire", "gunner", "sight", "day sight"])
    is_robot = any(w in text for w in ["robot", "dog", "autonomous", "engraver", "wire"])
    is_map = any(w in text for w in ["route", "flight", "norway", "arctic", "desert", "edwards", "airfield", "corridor", "map", "theater", "deploy", "patrol"])

    if is_thermal:
        pool = ["WALK", "SCHEMATIC_HEAT", "PHOTO", "TERMINAL", "CONFRONTATION", "SCHEMATIC_HEAT"]
    elif is_arctic:
        pool = ["WALK", "MAP_ARCTIC", "SCHEMATIC_ARCTIC", "PHOTO", "TERMINAL", "CONFRONTATION"]
    elif is_nvg:
        pool = ["WALK", "SCHEMATIC_NVG", "PHOTO", "FINANCE_NVG", "TERMINAL", "CONFRONTATION"]
    elif is_optical:
        pool = ["WALK", "SCHEMATIC_OPTICAL", "PHOTO", "COCKPIT", "TERMINAL", "CONFRONTATION"]
    elif is_canopy:
        pool = ["WALK", "SCHEMATIC_CANOPY", "PHOTO", "FINANCE_CANOPY", "TERMINAL", "CONFRONTATION"]
    elif is_humvee:
        pool = ["WALK", "SCHEMATIC_HUMVEE", "PHOTO", "TERMINAL", "CONFRONTATION", "FINANCE_HUMVEE"]
    elif is_sponge:
        pool = ["WALK", "FINANCE_SPONGE", "PHOTO", "TERMINAL", "CONFRONTATION", "WALK"]
    elif is_stencil:
        pool = ["WALK", "FINANCE_STENCIL", "PHOTO", "TERMINAL", "CONFRONTATION", "WALK"]
    elif is_senate:
        pool = ["CONFRONTATION", "FINANCE_SENATE", "PHOTO", "TERMINAL", "WALK", "CONFRONTATION"]
    elif is_carrier:
        pool = ["COCKPIT", "MAP_CARRIER", "PHOTO", "TERMINAL", "CONFRONTATION", "WALK"]
    elif is_symbol_x:
        pool = ["WALK", "SCHEMATIC_SYMBOL_X", "PHOTO", "TERMINAL", "CONFRONTATION", "WALK"]
    elif is_triage:
        pool = ["WALK", "SCHEMATIC_TRIAGE", "PHOTO", "TERMINAL", "CONFRONTATION", "WALK"]
    elif is_breach:
        pool = ["WALK", "SCHEMATIC_BREACH", "PHOTO", "TERMINAL", "CONFRONTATION", "WALK"]
    elif is_abrams:
        pool = ["WALK", "SCHEMATIC_ABRAMS", "PHOTO", "TERMINAL", "CONFRONTATION", "WALK"]
    elif is_robot:
        pool = ["WALK", "SCHEMATIC_ROBOT", "PHOTO", "TERMINAL", "CONFRONTATION", "WALK"]
    elif is_map:
        pool = ["WALK", "MAP_DOMESTIC", "PHOTO", "TERMINAL", "CONFRONTATION", "WALK"]
    elif idx == 0:
        pool = ["WALK", "MAP_DOMESTIC", "FINANCE_PROGRAM", "PHOTO", "TERMINAL", "CONFRONTATION"]
    else:
        pool = ["WALK", "PHOTO", "TERMINAL", "CONFRONTATION", "FINANCE_PROGRAM", "WALK"]

    subshots = [pool[i % len(pool)] for i in range(num_subshots)]

    # Generate custom pop titles per sub-shot
    titles = []
    for stype in subshots:
        if stype == "SCHEMATIC_HEAT":
            titles.append("KUSUR #1: 48°C TERMAL ERİME KRİZİ!")
        elif stype == "SCHEMATIC_NVG":
            titles.append("KUSUR #3: GECE GÖRÜŞÜNDE PARLAMA!")
        elif stype == "SCHEMATIC_OPTICAL":
            titles.append("KUSUR #5: KIRMIZI IŞIK KÖRLÜĞÜ!")
        elif stype == "SCHEMATIC_CANOPY":
            titles.append("$280.000'LIK KOKPİT CAMI HASARI!")
        elif stype == "SCHEMATIC_HUMVEE":
            titles.append("HUMVEE HAVALANDIRMASINDA DUMAN KRİZİ!")
        elif stype == "SCHEMATIC_ARCTIC":
            titles.append("NORVEÇ: -30°C'DE KIRILAN KALEMLER!")
        elif stype == "SCHEMATIC_SYMBOL_X":
            titles.append("KENTSEL SAVAŞIN GİZLİ DİLİ: 'X' İŞARETİ!")
        elif stype == "SCHEMATIC_TRIAGE":
            titles.append("HAYAT KURTARAN 4 RENKLİ TRİYAJ HAÇI!")
        elif stype == "SCHEMATIC_BREACH":
            titles.append("C4 PATLAYICI VE DUVAR DELME ANKRAJI!")
        elif stype == "SCHEMATIC_ABRAMS":
            titles.append("M1 ABRAMS TANKINI DURDURAN ÇİZGİ!")
        elif stype == "SCHEMATIC_ROBOT":
            titles.append("ROBOT KÖPEK VE DİKENLİ TEL REZALETİ!")
        elif "FINANCE" in stype:
            if "SPONGE" in stype:
                titles.append("$4.800'LIK ASKERİ SÜNGER SKANDALI!")
            elif "STENCIL" in stype:
                titles.append("$12.000'LIK TİTANYUM ŞABLON!")
            elif "CANOPY" in stype:
                titles.append("$280.000 KOKPİT CAMI MASRAFI!")
            elif "SENATE" in stype:
                titles.append("SENATO: $80 MİLYONLUK HESAP SORUŞTURMASI!")
            elif "NVG" in stype:
                titles.append("$850'LIK ADET BAŞINA KALEM MALİYETİ!")
            elif "54" in text:
                titles.append("$54 MİLYARLIK ÇÖPE GİDEN İHALE!")
            else:
                titles.append("$68.4 MİLYAR DOLARLIK ASKERİ BÜTÇE!")
        elif "MAP" in stype:
            if "ARCTIC" in stype:
                titles.append("KUTUP DAİRESİ VE NATO TATBİKAT ROTASI!")
            elif "CARRIER" in stype:
                titles.append("UÇAK GEMİSİ VE DENİZ GÖREV ROTASI!")
            else:
                titles.append("GİZLİ HAVA ÜSSÜ VE STRATEJİK UÇUŞ ROTASI!")
        elif stype == "PHOTO":
            if "rollout" in text:
                titles.append("PALMDALE PLANT 42 GİZLİ HANGAR ÇIKIŞI!")
            elif "b-2" in text or "spirit" in text:
                titles.append("EFSANEVİ B-2 SPIRIT HAYALET BOMBARDIRMAN!")
            elif "b-21" in text or "raider" in text:
                titles.append("USAF GİZLİLİK KALKTI: B-21 RAIDER UÇUŞU!")
            else:
                titles.append("PENTAGON ARŞİVİ // ÇOK GİZLİ BELGE")
        elif stype == "TERMINAL":
            titles.append(f"PENTAGON DENETİM RAPORU // {chapter[:22]}")
        elif stype == "CONFRONTATION":
            titles.append("PENTAGON VE CEO KARŞI KARŞIYA!")
        elif stype == "COCKPIT":
            titles.append("MACH 1.8 KOKPİT TELEMETRİSİ VE AVİYONİK!")
        else: # WALK
            if "1" in chapter or "first" in narr:
                titles.append("KUSUR #1: BALMUMU ERİMESİ!")
            elif "2" in chapter or "second" in narr:
                titles.append("KUSUR #2: HARİTA LİKİT KORUMASI!")
            elif "3" in chapter or "third" in narr:
                titles.append("KUSUR #3: KIZILÖTESİ GECE GÖRÜŞÜ!")
            elif "4" in chapter or "fourth" in narr:
                titles.append("KUSUR #4: HARİTA KATMAN KARMAŞASI!")
            elif "5" in chapter or "fifth" in narr:
                titles.append("KUSUR #5: KIRMIZI IŞIK KÖRLÜĞÜ!")
            elif chapter and len(chapter) > 4:
                titles.append(chapter[:36])
            else:
                titles.append(f"{vehicle_name.upper()[:25]}: GERÇEKLER!")

    return subshots, titles


def mix_scene_audio(narration_wav: Path, sfx_events: list, output_wav: Path, speaker_side: str = "CENTER"):
    pan_str = "pan=stereo|c0=0.707*c0|c1=0.707*c0"
    valid_sfx = [(p, d, v) for p, d, v in sfx_events if p.exists()]
    if not valid_sfx:
        cmd = [FFMPEG_BIN, "-y", "-i", str(narration_wav), "-af", pan_str, "-c:a", "pcm_s16le", str(output_wav)]
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        return

    cmd = [FFMPEG_BIN, "-y", "-i", str(narration_wav)]
    filter_inputs = ["[vocal]"]
    filter_parts = [f"[0:a]{pan_str}[vocal];"]

    for i, (sfx_p, delay_s, vol) in enumerate(valid_sfx):
        cmd.extend(["-i", str(sfx_p)])
        delay_ms = max(0, int(delay_s * 1000))
        filter_parts.append(f"[{i+1}:a]adelay={delay_ms}|{delay_ms},volume={vol},aformat=channel_layouts=stereo[sfx{i}];")
        filter_inputs.append(f"[sfx{i}]")

    n_in = len(filter_inputs)
    joined_inputs = "".join(filter_inputs)
    filter_parts.append(f"{joined_inputs}amix=inputs={n_in}:duration=first:dropout_transition=0:normalize=0[aout]")

    cmd.extend([
        "-filter_complex", "".join(filter_parts),
        "-map", "[aout]",
        "-c:a", "pcm_s16le",
        str(output_wav)
    ])
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)


# ── PROCEDURAL SCHEMATIC DRAWERS ──
def render_procedural_schematic(frame: Image.Image, draw: ImageDraw.ImageDraw, stype: str, t_sub: float, scene_data: dict):
